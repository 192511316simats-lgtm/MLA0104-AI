import heapq

graph = {
    'Start': [('Rack A', 5), ('Rack B', 2)],
    'Rack A': [('Rack C', 2)],
    'Rack B': [('Rack C', 1), ('Goal', 4)],
    'Rack C': [('Goal', 1)],
    'Goal': []
}

h = {
    'Start': 6,
    'Rack A': 4,
    'Rack B': 3,
    'Rack C': 1,
    'Goal': 0
}

def greedy_search(start, goal):
    pq = [(h[start], start, [start])]
    visited = set()

    while pq:
        _, node, path = heapq.heappop(pq)

        if node == goal:
            return path

        if node in visited:
            continue

        visited.add(node)

        for neighbour, cost in graph[node]:
            if neighbour not in visited:
                heapq.heappush(
                    pq,
                    (h[neighbour], neighbour,
                     path + [neighbour])
                )

    return None

print("Greedy Path:", greedy_search('Start', 'Goal'))
