def alphabeta(values, depth, index, maximizing, alpha, beta):

    if depth == 2:
        return values[index]

    if maximizing:
        best = float('-inf')

        for i in range(2):
            value = alphabeta(
                values, depth + 1,
                index * 2 + i, False, alpha, beta
            )

            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                print("Branch Pruned")
                break

        return best

    else:
        best = float('inf')

        for i in range(2):
            value = alphabeta(
                values, depth + 1,
                index * 2 + i, True, alpha, beta
            )

            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                print("Branch Pruned")
                break

        return best


values = [3, 5, 2, 9]

result = alphabeta(
    values, 0, 0, True,
    float('-inf'), float('inf')
)

print("Optimal Value:", result)
