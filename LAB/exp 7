def minimax(tree, depth, maximizing):
    if depth == 2:
        return tree.pop(0)

    if maximizing:
        return max(
            minimax(tree, depth + 1, False),
            minimax(tree, depth + 1, False)
        )
    else:
        return min(
            minimax(tree, depth + 1, True),
            minimax(tree, depth + 1, True)
        )

values = [3, 5, 2, 9]

result = minimax(values, 0, True)

print("Best value for MAX player:", result)
